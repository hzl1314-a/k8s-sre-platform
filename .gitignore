# 本地产物
*.log
probe.log
*.tgz
*.tar

# 下载的官方清单（体积大、可由上游重新拉取，不入库；但保留说明文件）
downloads/*
!downloads/README.md
calico-operator.yaml
tigera-operator.yaml
calico-custom-resources.yaml
kubernetes-manifests.yaml
metrics-server-components.yaml
traefik-*.tgz
*-values-*.tgz

# 敏感信息：kubeconfig 与告警凭据
*.kubeconfig
kubeconfig
admin.conf
*-secret.yaml
.env
# 钉钉转发的真实配置（含 access_token 与加签 secret）。
# 入库的只有 manifests/alerts/dingtalk-webhook-config.example.yml（占位符版）。
dingtalk-config.yml
*-dingtalk-config.yml
!*-dingtalk-config.example.yml

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.samples

# Python
__pycache__/
*.pyc

# 例外：docs 下的演练/压测/修复证据日志是证据链，必须入库（其余 *.log 仍忽略）
!docs/*.log
!docs/*.bak

# 合成截图的中间产物（生成器脚本是唯一事实来源）
docs/screenshots/*.html
!docs/screenshots/*.log
